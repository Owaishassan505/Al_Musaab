# RewriteEngine On

# # Only rewrite if the request isn't for a real file or folder
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d

# # Rewrite URLs to .php equivalents
# RewriteRule ^(.+?)/?$ $1.php [L]


RewriteEngine On

# Skip rewriting the root
RewriteCond %{REQUEST_URI} !^/$

# Only rewrite if not a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite pretty URLs to PHP files
RewriteRule ^(.+?)/?$ $1.php [L]